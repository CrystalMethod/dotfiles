# Ghostty configuration
# Managed by chezmoi: home/dot_config/ghostty/config

# Theme: Catppuccin Frappe (bundled with Ghostty)
theme = Catppuccin Frappe

# Font
# MonoLisa is the primary coding font; JetBrains Mono is the fallback for any
# codepoint MonoLisa does not cover (repeated font-family lines append fallbacks).
font-family = "MonoLisa"
font-family = "JetBrains Mono"
font-size = 13
# MonoLisa features: ss01 = normal asterisk, zero = slashed zero. Ligatures
# (liga/calt) stay off per previous preference.
font-feature = "-calt, -liga, ss01, zero"

# Cursor
cursor-style = block
cursor-style-blink = false

# Window
window-padding-x = 8
window-padding-y = 8
window-theme = ghostty
background-opacity = 0.95
# macOS: hide the titlebar and proxy icon for a clean, tmux-centric surface
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden

# Behavior
mouse-hide-while-typing = true
shell-integration = detect
confirm-close-surface = false
