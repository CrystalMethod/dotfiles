{{- $name := "" -}}
{{- if hasKey . "name" -}}
{{-   $name = .name -}}
{{- else -}}
{{-   $name = promptString "Display name" -}}
{{- end -}}

{{- $email := "" -}}
{{- if hasKey . "email" -}}
{{-   $email = .email -}}
{{- else -}}
{{-   $email = promptString "Email address" -}}
{{- end -}}

{{- $system := "" -}}
{{- if hasKey . "system" -}}
{{-   $system = .system -}}
{{- /* Set client to the MacOS default system */ -}}
{{- else if eq .chezmoi.os "darwin" -}}
{{    $system = "client" -}}
{{- /* Auto-select client on WSL2 (WSL_DISTRO_NAME is set in WSL2) */ -}}
{{- else if env "WSL_DISTRO_NAME" -}}
{{-   $system = "client" -}}
{{- else -}}
{{-   $system = promptString "System (client or server)" -}}
{{- end -}}

{{- $mode := "" -}}
{{- if hasKey . "mode" -}}
{{-   $mode = .mode -}}
{{- /* Prefer the mode chosen by setup.sh when present */ -}}
{{- else if env "DOTFILES_MODE" -}}
{{-   $mode = env "DOTFILES_MODE" -}}
{{- else -}}
{{-   $mode = promptString "Mode (privileged or user)" -}}
{{- end -}}

diff:
  exclude:
    - scripts

data:
    name: {{ $name | quote }}
    email: {{ $email | quote }}
    system: {{ $system | quote }}
    mode: {{ $mode | quote }}

{{ if ne (env "CI") "true" -}}
encryption: "age"
age:
    identity: "~/.config/age/key.txt"
    recipient: "age120sfdn2g9r9r3yt9j65pcxencjnj328ek9jswqjredpvex5wnsespreu5l"
{{- end }}
